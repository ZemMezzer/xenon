# Applied through CMAKE_PROJECT_LLVM_INCLUDE. Keep the upstream checkout clean:
# only this translation unit is copied into the build tree and replaced on its
# original target. Both static NativeAOT and the managed C API runtime link it.
function(xenon_patch_llvm_indvars)
  set(_original "${LLVM_MAIN_SRC_DIR}/lib/Transforms/Utils/SimplifyIndVar.cpp")
  file(READ "${_original}" _source)
  set(_needle "      LCSSAPhiUsers.push_back(LCSSAPhi);")
  set(_replacement "      // A catchswitch is both an EH pad and a terminator. There is no\n      // insertion point for the trunc required by widening this exit PHI.\n      // Reject before mutating IR, as widenIVUse already does.\n      if (isa<CatchSwitchInst>(LCSSAPhi->getParent()->getTerminator()))\n        return false;\n      LCSSAPhiUsers.push_back(LCSSAPhi);")
  string(FIND "${_source}" "${_needle}" _position)
  if(_position EQUAL -1)
    message(FATAL_ERROR "LLVM induction-variable patch no longer matches; review the upstream change")
  endif()
  string(REPLACE "${_needle}" "${_replacement}" _patched "${_source}")
  set(_output "${LLVM_BINARY_DIR}/xenon-patches/SimplifyIndVar.cpp")
  if(EXISTS "${_output}")
    file(READ "${_output}" _previous)
  endif()
  if(NOT _previous STREQUAL _patched)
    file(WRITE "${_output}" "${_patched}")
  endif()
  get_target_property(_sources LLVMTransformUtils SOURCES)
  list(FIND _sources SimplifyIndVar.cpp _index)
  if(_index EQUAL -1)
    message(FATAL_ERROR "Cannot replace LLVMTransformUtils/SimplifyIndVar.cpp")
  endif()
  list(REMOVE_AT _sources ${_index})
  list(APPEND _sources "${_output}")
  set_property(TARGET LLVMTransformUtils PROPERTY SOURCES "${_sources}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_original}")
endfunction()
cmake_language(DEFER CALL xenon_patch_llvm_indvars)
