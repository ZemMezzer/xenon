namespace IntegerOperators;
int Main()
{
    int value = 5;
    value += 3; value *= 4; value -= 2; value /= 5; value %= 5;
    if (value != 1) return 1;
    value |= 8; value ^= 3; value &= 10;
    if (value != 10) return 2;
    value <<= 2; value >>= 1;
    if (value != 20) return 3;
    int before = value++; int after = ++value;
    if (before != 20 || after != 22) return 4;
    before = value--; after = --value;
    if (before != 22 || after != 20) return 5;
    if (~cast<byte>(0) != cast<byte>(255)) return 6;
    byte wrapped = cast<byte>(255) + cast<byte>(1);
    if (wrapped != cast<byte>(0)) return 7;
    uint shifted = cast<uint>(2147483648) >> 31;
    if (shifted != cast<uint>(1)) return 8;
    return value + 22;
}
