namespace ReadonlyMethodOverloads;
struct Container
{
    public int Value;
    public int& Get() { return Value; }
    public readonly int& readonly Get() { return Value; }
}
int Main()
{
    Container value = Container { 7 };
    Container& mutable = value;
    readonly Container& readOnly = mutable;
    int& writable = mutable.Get(); writable = 42;
    readonly int& readable = readOnly.Get();
    return readable;
}
