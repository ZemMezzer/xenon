namespace GenericMixedConstraintCapabilitiesRuntime;

struct BaseRunnable { public int Run() { return 40; } }
interface IStateful { int State(); }
template Advanced { int Run(); int State(); }

struct Required<T> where T : Advanced
{
    public T value;
    public Required(T value) { this.value = move value; }
    public int Execute() { return value.Run() + value.State(); }
}

struct Outer<T> where T : BaseRunnable, IStateful
{
    public Required<T> required;
    public Outer(T value) { required = Required<T>(move value); }
    public int Execute() { return required.Execute(); }
}

struct Worker : BaseRunnable, IStateful
{
    public int State() { return 2; }
}

int Main()
{
    Outer<Worker> value = Outer<Worker>(Worker());
    if (value.Execute() != 42) return 1;
    return 0;
}
