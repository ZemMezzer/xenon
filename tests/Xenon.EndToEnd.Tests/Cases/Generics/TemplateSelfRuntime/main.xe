namespace GenericTemplateSelfRuntime;

struct Box<T> { public T value; public Box(T value) { this.value = move value; } }
struct Wrapper<T> { public T value; public Wrapper(T value) { this.value = move value; } }

template Equalable { bool Equals(Equalable other); }
template Processor { int Process(Box<Processor> value); }
template DeepProcessor { int ProcessDeep(Wrapper<Box<DeepProcessor>> value); }

struct Worker
{
    public int value;
    public Worker(int value) { this.value = value; }
    public bool Equals(Worker other) { return value == other.value; }
    public int Process(Box<Worker> input) { return input.value.value; }
    public int ProcessDeep(Wrapper<Box<Worker>> input) { return input.value.value.value; }
}

bool AreEqual<T>(T left, T right) where T : Equalable { return left.Equals(move right); }
int Execute<T>(T worker, Box<T> value) where T : Processor { return worker.Process(move value); }
int ExecuteDeep<T>(T worker, Wrapper<Box<T>> value) where T : DeepProcessor
{ return worker.ProcessDeep(move value); }

int Main()
{
    Worker first = Worker(42);
    Worker same = Worker(42);
    Worker different = Worker(41);
    Box<Worker> box = Box<Worker>(first);
    Wrapper<Box<Worker>> wrapper = Wrapper<Box<Worker>>(box);
    if (!AreEqual<Worker>(first, same) || AreEqual<Worker>(first, different)) return 1;
    if (Execute<Worker>(first, box) != 42) return 2;
    if (ExecuteDeep<Worker>(first, wrapper) != 42) return 3;
    return 0;
}
