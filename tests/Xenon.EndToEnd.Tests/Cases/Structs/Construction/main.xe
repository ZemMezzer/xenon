namespace Construction;
struct Counter
{
    public int Value;
    public Counter(int value) { Value = value; }
    public void Add(int value) { Value += value; }
}
int Main()
{
    Counter value = Counter(20);
    Counter copy = value;
    copy.Add(22);
    if (value.Value != 20) return 1;
    return copy.Value;
}
