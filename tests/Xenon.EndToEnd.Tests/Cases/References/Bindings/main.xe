namespace References;
void Increment(int& value) { value++; }
int Read(readonly int& value) { return value; }
struct Holder { public int& Value; public Holder(int& value) { Value = value; } }
struct DerivedHolder : Holder
{
    public readonly int& Other;
    public DerivedHolder(int& value) : base(value) { this.Other = value; }
}
struct Outer { public Holder Inner; public Outer(int& value) { Inner = Holder(value); } }
int Main()
{
    int value = 20;
    int& alias = value;
    readonly int& view = value;
    Increment(alias);
    DerivedHolder holder = DerivedHolder(value);
    holder.Value = 22;
    Outer outer = Outer(value);
    outer.Inner.Value = 42;
    Holder positional = Holder { value };
    if (view != 42 || holder.Other != 42 || positional.Value != 42) return 1;
    return Read(view);
}
