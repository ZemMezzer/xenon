<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xenon</AssemblyName>
    <RootNamespace>Xenon.Cli</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/XenonBuildInfo.cs" Link="XenonBuildInfo.cs" />
    <None Include="../../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(LLVMNativePropsFile)"
          Condition="'$(XenonStaticLLVM)' == 'true' and Exists('$(LLVMNativePropsFile)')" />

  <Target Name="ValidateStaticLlvmConfiguration"
          BeforeTargets="Publish"
          Condition="'$(XenonStaticLLVM)' == 'true'">
    <Error Condition="'$(LLVMNativePropsFile)' == ''"
           Text="LLVMNativePropsFile must point to the CMake-generated static LLVM props file." />
    <Error Condition="!Exists('$(LLVMNativePropsFile)')"
           Text="Static LLVM props file was not found: $(LLVMNativePropsFile)" />
  </Target>

  <ItemGroup Condition="'$(XenonStaticLLVM)' == 'true'">
    <!-- LLVMSharp imports the C API from 'libLLVM'. NativeAOT resolves these
         imports directly against the CMake-built static component archives. -->
    <DirectPInvoke Include="libLLVM" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Xenon.CodeGen.LLVM/Xenon.CodeGen.LLVM.csproj" />
    <ProjectReference Include="../Xenon.Compiler/Xenon.Compiler.csproj" />
    <ProjectReference Include="../Xenon.Driver/Xenon.Driver.csproj" />
    <ProjectReference Include="../Xenon.LanguageServer/Xenon.LanguageServer.csproj" />
    <ProjectReference Include="../Xenon.ProjectSystem/Xenon.ProjectSystem.csproj" />
  </ItemGroup>
</Project>
