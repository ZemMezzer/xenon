namespace EnumConversions;
const int Start = 10;
enum State : byte { Idle, Running = Start, Alias = Running, Stopped }
enum Signed : sbyte { Negative = -1 }
int Main()
{
    State state = cast<State>(10);
    if (state != State.Running || state != State.Alias) return 1;
    if (cast<int>(State.Stopped) != 11 || cast<int>(Signed.Negative) != -1) return 2;
    int result = 0;
    for (int i = 0; i < 4; i++)
    {
        switch (i)
        {
            case 0: continue;
            case 1:
            case 2: result += i; break;
            default: result += 4; break;
        }
        result += 1;
    }
    if (result != 10) return 3;
    switch (state) { case State.Running: result += 32; break; default: return 4; }
    return result;
}
