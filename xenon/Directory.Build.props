<Project>
  <Import Project="$(MSBuildThisFileDirectory)Versions.props" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Root CMake passes build/<platform>. The fallback keeps direct dotnet
         invocations source-clean as well. -->
    <XenonRootBuildDirectory Condition="'$(XenonRootBuildDirectory)' == ''">$(MSBuildThisFileDirectory)..\build\local\</XenonRootBuildDirectory>
    <XenonRootBuildDirectoryNormalized>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(XenonRootBuildDirectory)'))))</XenonRootBuildDirectoryNormalized>
    <XenonBinDirectory>$(XenonRootBuildDirectoryNormalized)xenon\bin\</XenonBinDirectory>
    <XenonObjDirectory>$(XenonRootBuildDirectoryNormalized)xenon\obj\</XenonObjDirectory>
    <BaseOutputPath>$(XenonBinDirectory)$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(XenonObjDirectory)$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- Keep artifacts produced with the SDK defaults out of implicit Compile items.
         This matters after switching to the repository-wide output paths above. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/CMakeFiles/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
